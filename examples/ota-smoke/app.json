{
  "expo": {
    "name": "OTA Smoke",
    "slug": "ota-smoke",
    "version": "1.0.0",
    "runtimeVersion": "1",
    "updates": {
      "url": "https://example.com/ota/api/v1/projects/ota-smoke/manifest",
      "requestHeaders": { "expo-channel-name": "production" },
      "enableBsdiffPatchSupport": true,
      "codeSigningCertificate": "./certificate.pem",
      "codeSigningMetadata": { "keyid": "main", "alg": "rsa-v1_5-sha256" }
    },
    "ios": { "bundleIdentifier": "com.example.otasmoke" },
    "android": { "package": "com.example.otasmoke" }
  }
}
